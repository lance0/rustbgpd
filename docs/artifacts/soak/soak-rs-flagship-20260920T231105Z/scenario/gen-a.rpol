# reload-stall policy generation - generated by gen-scenario.py.
#
# member-in is byte-for-byte stable across generations.
# Only the first 1000 observers use member-out, whose community changes;
# the remaining observers use the content-stable stable-out chain.
# The harness samples the export community to confirm the live generation.
policy member-in {
    term drop-blocked { if route.prefix == 192.0.2.0/24 { reject } }
    term default { accept }
}

policy member-out {
    term tag { add community 65400:1000; accept }
}


policy stable-out {
    term tag { add community 65400:9000; accept }
}

