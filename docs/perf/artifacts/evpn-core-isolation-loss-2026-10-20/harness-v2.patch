+class LossRecoverTests(unittest.TestCase):
+    def test_both_arms_reset_both_neighbors_after_restoring_the_underlay(self):
+        for arm, action in [('loss-action', True), ('loss-control', False)]:
+            with self.subTest(arm=arm):
+                calls = []
+                with patch.object(driver, 'wait'), patch.object(driver, 'send'), \
+                        patch.object(driver.time, 'sleep'), \
+                        patch.object(driver, 'run', side_effect=lambda *a, **k: calls.append(('run', a))), \
+                        patch.object(driver, 'ctl', side_effect=lambda *a: calls.append(('ctl', a)) or {}), \
+                        patch.object(driver, 'event', side_effect=lambda name, **f: calls.append(('event', name))):
+                    row = driver.loss_recover(arm, 1, action)
+                restore = calls.index(('run', ('ip', 'link', 'set', 'ul-b', 'up')))
+                resets = [i for i, c in enumerate(calls) if c[0] == 'ctl' and c[1][-1] == 'reset']
+                self.assertEqual([calls[i][1] for i in resets],
+                                 [('neighbor', driver.IPS['a'], 'reset'), ('neighbor', driver.IPS['r'], 'reset')])
+                self.assertTrue(all(i > restore for i in resets))
+                self.assertIn(('event', 'loss_reset'), calls)
+                self.assertEqual(set(row), {'reset_ns', 'restore_to_reset_ms', 'reset_to_steady_s'})
+
+
