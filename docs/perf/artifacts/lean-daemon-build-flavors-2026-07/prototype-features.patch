diff --git a/crates/event-history/src/storage_disabled.rs b/crates/event-history/src/storage_disabled.rs
new file mode 100644
index 00000000..5daa0140
--- /dev/null
+++ b/crates/event-history/src/storage_disabled.rs
@@ -0,0 +1,124 @@
+//! Compile-only storage facade for daemon builds without durable history.
+//!
+//! Production config validation refuses `[event_history].enabled = true`
+//! before this path can be constructed.
+
+use std::sync::Arc;
+
+use tokio::task::JoinHandle;
+
+use crate::{Category, EventEnvelope, EventHistoryError, Severity, SynchronousMode};
+
+#[derive(Debug)]
+pub(crate) struct AppendOutcome {
+    pub assigned_ids: Vec<u64>,
+    pub new_high_water: u64,
+    pub daemon_boot_id: Arc<str>,
+    pub db_size_bytes: u64,
+}
+
+#[derive(Debug)]
+pub(crate) struct QueryWithFloorOutcome {
+    pub rows: Vec<PersistedEvent>,
+    pub floor: Option<u64>,
+}
+
+#[derive(Debug, Default, Clone, Copy)]
+pub struct RetentionOutcome {
+    pub evicted_count_cap: usize,
+    pub evicted_byte_cap: usize,
+    pub db_size_bytes: u64,
+}
+
+#[derive(Debug, Default, Clone)]
+pub struct QueryFilter {
+    pub category: Option<Category>,
+    pub peer: Option<String>,
+    pub prefix: Option<String>,
+    pub rd: Option<String>,
+}
+
+#[derive(Debug, Clone)]
+pub struct PersistedEvent {
+    pub event_id: u64,
+    pub timestamp_ns: i64,
+    pub category: Category,
+    pub event_type: String,
+    pub peer: Option<String>,
+    pub previous_peer: Option<String>,
+    pub target_peer: Option<String>,
+    pub afi_safi: Option<String>,
+    pub prefix: Option<String>,
+    pub rd: Option<String>,
+    pub evpn_route_type: Option<i32>,
+    pub severity: Severity,
+    pub daemon_boot_id: String,
+    pub payload_codec: String,
+    pub payload: Vec<u8>,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct StoreHandle;
+
+impl StoreHandle {
+    pub(crate) async fn append(
+        &self,
+        _envelopes: Vec<Arc<EventEnvelope>>,
+    ) -> Result<AppendOutcome, EventHistoryError> {
+        Err(EventHistoryError::PassThrough)
+    }
+
+    pub(crate) async fn query(
+        &self,
+        _from_event_id: u64,
+        _to_event_id: u64,
+        _limit: usize,
+        _filter: QueryFilter,
+    ) -> Result<Vec<PersistedEvent>, EventHistoryError> {
+        Err(EventHistoryError::PassThrough)
+    }
+
+    pub(crate) async fn query_with_floor(
+        &self,
+        _from_event_id: u64,
+        _to_event_id: u64,
+        _limit: usize,
+        _filter: QueryFilter,
+    ) -> Result<QueryWithFloorOutcome, EventHistoryError> {
+        Err(EventHistoryError::PassThrough)
+    }
+
+    pub(crate) async fn retain(
+        &self,
+        _max_events: u64,
+        _max_bytes: u64,
+    ) -> Result<RetentionOutcome, EventHistoryError> {
+        Err(EventHistoryError::PassThrough)
+    }
+
+    pub(crate) async fn flush_sidecar(&self) -> Result<u64, EventHistoryError> {
+        Err(EventHistoryError::PassThrough)
+    }
+
+    pub(crate) async fn oldest_event_id(&self) -> Result<Option<u64>, EventHistoryError> {
+        Err(EventHistoryError::PassThrough)
+    }
+
+    pub(crate) async fn shutdown(&self) {}
+}
+
+pub(crate) fn spawn_store(
+    _path: std::path::PathBuf,
+    _daemon_boot_id: Arc<str>,
+    _synchronous: SynchronousMode,
+    _capacity: usize,
+) -> Result<(StoreHandle, JoinHandle<()>, StorageInit), EventHistoryError> {
+    Err(EventHistoryError::PassThrough)
+}
+
+#[derive(Debug)]
+pub(crate) struct StorageInit {
+    pub had_quarantine: bool,
+    pub initial_allocator: u64,
+    pub recovered_via_fallback: bool,
+}
