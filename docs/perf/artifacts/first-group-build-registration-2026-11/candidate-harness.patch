@@ -0,0 +1,260 @@
+//! Scratch observer for one first-member registration per rrharness process.
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+use crate::PeerId;
+
+static ORIGIN: OnceLock<Instant> = OnceLock::new();
+static TARGET: OnceLock<PeerId> = OnceLock::new();
+static STARTED: AtomicBool = AtomicBool::new(false);
+static FIRST_WORK: AtomicBool = AtomicBool::new(false);
+static PUBLISHED: AtomicBool = AtomicBool::new(false);
+static ENDED: AtomicBool = AtomicBool::new(false);
+static RECORDED: AtomicBool = AtomicBool::new(false);
+static OBS: Mutex<Option<RegistrationObservation>> = Mutex::new(None);
+
+#[derive(Debug, Default)]
+pub struct RegistrationObservation {
+    pub deferred: bool,
+    pub readiness_owned: bool,
+    pub owner_start_ns: u64,
+    pub owner_end_ns: u64,
+    pub poll_start_ns: u64,
+    pub poll_end_ns: u64,
+    pub max_actor_poll_ns: u64,
+    pub install_end_ns: u64,
+    pub build_start_ns: u64,
+    pub build_end_ns: u64,
+    pub collect_start_ns: u64,
+    pub collect_end_ns: u64,
+    pub stage_end_ns: u64,
+    pub delta_retire_end_ns: u64,
+    pub set_retire_start_ns: u64,
+    pub set_retire_end_ns: u64,
+    pub replay_start_ns: u64,
+    pub replay_end_ns: u64,
+    pub loc_rows: usize,
+    pub collected_rows: usize,
+    pub staged_rows: usize,
+    pub stage_deltas: usize,
+    pub retired_keys: usize,
+    pub replay_visited: usize,
+    pub replay_rows: usize,
+    pub map_insert_ns: u64,
+    pub published_ns: u64,
+    pub build_active_ns: u64,
+    pub replay_poll_ns: u64,
+    pub max_build_only_poll_ns: u64,
+    pub build_poll_count: usize,
+    pub build_only_poll_count: usize,
+    pub max_poll_visits: usize,
+    pub max_poll_discovery: usize,
+    pub max_poll_repairs: usize,
+    pub max_poll_staged: usize,
+    pub max_poll_retired: usize,
+    pub max_buffer_keys: usize,
+    pub max_changed_keys: usize,
+    pub max_provisional_tables: usize,
+    pub discovery_visits: usize,
+    pub repair_keys: usize,
+    pub cleanup_visits: usize,
+    pub paced: bool,
+    pub provisional_tables: usize,
+    poll_baseline: [usize; 4],
+    total_spans: usize,
+    prior_spans: usize,
+}
+
+fn nanos(at: Instant) -> u64 {
+    u64::try_from(at.duration_since(*ORIGIN.get().unwrap()).as_nanos()).unwrap()
+}
+
+pub fn now_ns() -> u64 {
+    ORIGIN.get_or_init(Instant::now);
+    nanos(Instant::now())
+}
+
+pub fn arm(peer: PeerId) {
+    now_ns();
+    TARGET.set(peer).expect("one registration per process");
+}
+
+pub(super) fn target(peer: PeerId) -> bool {
+    TARGET.get() == Some(&peer)
+}
+
+pub fn started() -> bool {
+    STARTED.load(Ordering::Acquire)
+}
+
+pub fn first_work_started() -> bool {
+    FIRST_WORK.load(Ordering::Acquire)
+}
+
+// Called on the first real key visit, or after the first nonempty candidate page.
+pub(super) fn signal_first_work() {
+    if active() && !first_work_started() {
+        FIRST_WORK.store(true, Ordering::Release);
+    }
+}
+
+pub fn building() -> bool {
+    first_work_started() && !PUBLISHED.load(Ordering::Acquire)
+}
+
+pub(super) fn publish() {
+    record(|o| {
+        o.build_end_ns = now_ns();
+        o.published_ns = o.build_end_ns;
+        PUBLISHED.store(true, Ordering::Release);
+    });
+}
+
+pub fn active() -> bool {
+    started() && !ENDED.load(Ordering::Acquire)
+}
+
+pub(crate) fn changed_backlog(count: usize) {
+    record(|o| o.max_changed_keys = o.max_changed_keys.max(count));
+}
+
+pub(crate) fn scan_page(buckets: usize, repairs: usize, keys: usize) {
+    if buckets + repairs > 0 {
+        signal_first_work();
+    }
+    record(|o| {
+        o.discovery_visits += buckets;
+        o.repair_keys += repairs;
+        o.collected_rows += keys - repairs;
+        o.max_buffer_keys = o.max_buffer_keys.max(keys);
+    });
+}
+
+pub(super) struct RegistrationWindow;
+
+pub(super) fn begin(peer: PeerId, deferred: bool) -> Option<RegistrationWindow> {
+    if !target(peer) {
+        return None;
+    }
+    if started() {
+        return (active() && PUBLISHED.load(Ordering::Acquire)).then(|| RegistrationWindow);
+    }
+    *OBS.lock().unwrap() = Some(RegistrationObservation {
+        deferred,
+        owner_start_ns: now_ns(),
+        ..Default::default()
+    });
+    STARTED.store(true, Ordering::Release);
+    Some(RegistrationWindow)
+}
+
+// A paced registration keeps its window across actor suspensions. Only the
+// real completion after publication may finish the observation.
+pub(super) fn begin_pending(peer: PeerId, loc_rows: usize) {
+    if !target(peer) {
+        return;
+    }
+    let mut guard = OBS.lock().unwrap();
+    let o = guard.get_or_insert_with(|| RegistrationObservation {
+        deferred: true,
+        owner_start_ns: now_ns(),
+        ..Default::default()
+    });
+    assert!(!o.paced && o.build_start_ns == 0, "one clean cold build");
+    o.paced = true;
+    o.loc_rows = loc_rows;
+    o.build_start_ns = now_ns();
+    STARTED.store(true, Ordering::Release);
+}
+
+impl Drop for RegistrationWindow {
+    fn drop(&mut self) {
+        record(|o| {
+            if !o.paced || o.published_ns != 0 {
+                o.owner_end_ns = now_ns();
+                ENDED.store(true, Ordering::Release);
+            }
+        });
+    }
+}
+
+pub(super) fn record(f: impl FnOnce(&mut RegistrationObservation)) {
+    if active() {
+        f(OBS.lock().unwrap().as_mut().unwrap());
+    }
+}
+
+pub(super) fn build_span() -> Option<BuildSpan> {
+    active().then(|| BuildSpan(now_ns()))
+}
+
+pub(super) struct BuildSpan(u64);
+
+impl Drop for BuildSpan {
+    fn drop(&mut self) {
+        let elapsed = now_ns() - self.0;
+        record(|o| {
+            o.build_active_ns += elapsed;
+            o.total_spans += 1;
+        });
+    }
+}
+
+pub(super) fn finished_poll(start: Instant, end: Instant) {
+    if !started() || RECORDED.load(Ordering::Relaxed) {
+        return;
+    }
+    let mut guard = OBS.lock().unwrap();
+    let obs = guard.as_mut().unwrap();
+    let (first, last) = (nanos(start), nanos(end));
+    let elapsed = last - first;
+    if obs.poll_start_ns == 0 {
+        assert!(first <= obs.owner_start_ns && obs.owner_start_ns <= last);
+        obs.poll_start_ns = first;
+    }
+    obs.max_actor_poll_ns = obs.max_actor_poll_ns.max(elapsed);
+    let totals = [
+        obs.discovery_visits,
+        obs.repair_keys,
+        obs.staged_rows,
+        obs.cleanup_visits,
+    ];
+    let work: [usize; 4] = std::array::from_fn(|i| totals[i] - obs.poll_baseline[i]);
+    obs.poll_baseline = totals;
+    obs.max_poll_visits = obs.max_poll_visits.max(work[0] + work[1] + work[3]);
+    obs.max_poll_discovery = obs.max_poll_discovery.max(work[0]);
+    obs.max_poll_repairs = obs.max_poll_repairs.max(work[1]);
+    obs.max_poll_staged = obs.max_poll_staged.max(work[2]);
+    obs.max_poll_retired = obs.max_poll_retired.max(work[3]);
+    // Replay (including payload/commit) has one synchronous owner. A poll
+    // containing both the last page and replay still counts toward the work
+    // limit; exclude its duration only from the build-only stall limit.
+    let replay =
+        obs.replay_start_ns != 0 && obs.replay_start_ns >= first && obs.replay_start_ns <= last;
+    if replay {
+        obs.replay_poll_ns = elapsed;
+    }
+    let worked = obs.total_spans > obs.prior_spans || work.iter().any(|v| *v != 0);
+    obs.prior_spans = obs.total_spans;
+    if worked {
+        obs.build_poll_count += 1;
+        if !replay {
+            obs.build_only_poll_count += 1;
+            obs.max_build_only_poll_ns = obs.max_build_only_poll_ns.max(elapsed);
+        }
+    }
+    if ENDED.load(Ordering::Acquire) {
+        assert!(first <= obs.owner_end_ns && obs.owner_end_ns <= last);
+        obs.poll_end_ns = last;
+        RECORDED.store(true, Ordering::Release);
+    }
+}
+
+pub fn take() -> Option<RegistrationObservation> {
+    if RECORDED.load(Ordering::Acquire) {
+        OBS.lock().unwrap().take()
+    } else {
+        None
+    }
+}
