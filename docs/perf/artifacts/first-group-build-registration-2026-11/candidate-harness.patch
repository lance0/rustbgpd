@@ -0,0 +1,349 @@
+// Scratch qualification mode. Each invocation owns a fresh RIB and one timed registration.
+use super::*;
+use rustbgpd_rib::manager::registration_probe as probe;
+
+const MARKER: Ipv4Addr = Ipv4Addr::new(198, 18, 0, 1);
+fn marker() -> Ipv4Prefix {
+    Ipv4Prefix::new(MARKER, 32)
+}
+
+fn actor_peak(metrics: &BgpMetrics) -> u64 {
+    metrics.publish_render_window_maxima();
+    metrics
+        .registry()
+        .gather()
+        .into_iter()
+        .find(|f| f.name() == "bgp_rib_actor_slice_max_microseconds")
+        .unwrap()
+        .get_metric()
+        .iter()
+        .find(|m| m.get_label()[0].value() == "actor_poll")
+        .unwrap()
+        .get_gauge()
+        .get_value() as u64
+}
+
+async fn count(tx: &mpsc::Sender<RibUpdate>) -> usize {
+    let (reply, response) = oneshot::channel();
+    tx.send(RibUpdate::QueryLocRibCount { reply })
+        .await
+        .unwrap();
+    response.await.unwrap()
+}
+
+fn target(peer: PeerId, outbound_tx: mpsc::Sender<OutboundRouteUpdate>) -> RibUpdate {
+    RibUpdate::PeerUp {
+        peer,
+        outbound_tx,
+        session_id: 1,
+        supersedes: None,
+        peer_asn: 64512,
+        peer_router_id: Ipv4Addr::new(192, 0, 2, 1),
+        export_policy: None,
+        sendable_families: vec![(Afi::Ipv4, Safi::Unicast)],
+        is_ebgp: false,
+        route_reflector_client: true,
+        orr_vantage: None,
+        per_client_best: false,
+        interpret_rfc1997: true,
+        add_path_send_families: vec![],
+        add_path_send_max: 0,
+        negotiated_orf_recv: vec![],
+        negotiated_llgr_families: vec![],
+    }
+}
+
+struct Receiver {
+    seen: Vec<bool>,
+    base: usize,
+    marker: bool,
+    eor: usize,
+    marker_pref: u32,
+    expect_marker_before_eor: bool,
+    marker_before_eor: bool,
+}
+impl Receiver {
+    fn new(rows: usize, marker_pref: u32, expect_marker_before_eor: bool) -> Self {
+        Self {
+            seen: vec![false; rows],
+            base: 0,
+            marker: false,
+            eor: 0,
+            marker_pref,
+            expect_marker_before_eor,
+            marker_before_eor: false,
+        }
+    }
+    fn fold(&mut self, update: &OutboundRouteUpdate) {
+        assert!(
+            update.unicast_withdrawals().next().is_none(),
+            "unexpected withdrawal"
+        );
+        assert!(
+            update.next_hop_override.iter().all(Option::is_none),
+            "unexpected next-hop override"
+        );
+        for route in update.announce.iter() {
+            assert_ne!(
+                update.announce_source_exclusion,
+                Some(route.peer),
+                "transport would omit this route"
+            );
+            let Prefix::V4(p) = route.prefix else {
+                panic!("unexpected address family")
+            };
+            assert_eq!(route.path_id, 0);
+            if p == marker() {
+                assert!(!self.marker, "duplicate marker");
+                self.marker_before_eor = self.eor == 0;
+                assert_eq!(
+                    self.marker_before_eor, self.expect_marker_before_eor,
+                    "marker on wrong side of initial EoR"
+                );
+                assert_eq!(route.peer.addr(), IpAddr::V4(source_addr(INGRESS_FLOOD)));
+                assert_eq!(route.next_hop, route.peer.addr());
+                assert_eq!(route.local_pref(), self.marker_pref);
+                self.marker = true;
+                continue;
+            }
+            let idx = ((u32::from(p.addr)
+                .checked_sub(u32::from(Ipv4Addr::new(20, 0, 0, 0)))
+                .unwrap())
+                >> 8) as usize;
+            assert!(
+                idx < self.seen.len() && p == flood_prefix(idx as u64),
+                "unexpected base key"
+            );
+            assert_eq!(self.eor, 0, "base row after EoR");
+            assert!(
+                !std::mem::replace(&mut self.seen[idx], true),
+                "duplicate base prefix"
+            );
+            let src =
+                (idx / (self.seen.len() / INGRESS_FLOOD as usize)).min(INGRESS_FLOOD as usize - 1);
+            assert_eq!(route.peer.addr(), IpAddr::V4(source_addr(src as u32)));
+            assert_eq!(route.next_hop, route.peer.addr());
+            assert_eq!(route.local_pref(), 100);
+            self.base += 1;
+        }
+        for &family in &update.end_of_rib {
+            assert_eq!(family, (Afi::Ipv4, Safi::Unicast));
+            assert_eq!(
+                self.base,
+                self.seen.len(),
+                "EoR before complete base inventory"
+            );
+            assert_eq!(
+                self.marker, self.expect_marker_before_eor,
+                "incomplete initial inventory"
+            );
+            self.eor += 1;
+            assert_eq!(self.eor, 1, "duplicate EoR");
+        }
+    }
+}
+
+pub(super) async fn run(args: &[String]) {
+    let [n, mode, arm] = args else {
+        panic!("usage: rrharness first-registration ROWS cold|warm|wrong parent|candidate");
+    };
+    let rows = n.parse::<usize>().unwrap();
+    assert!(rows >= INGRESS_FLOOD as usize);
+    let wrong = mode == "wrong";
+    let marker_pref = if wrong { 118 } else { 117 };
+    let warm = match mode.as_str() {
+        "cold" | "wrong" => false,
+        "warm" => true,
+        _ => panic!("use cold or warm"),
+    };
+    assert!(matches!(arm.as_str(), "parent" | "candidate"));
+    let sliced = arm == "candidate" && !warm;
+    let metrics = BgpMetrics::new();
+    let h = setup_with_metrics(u32::from(warm), INGRESS_FLOOD + 1, Some(metrics.clone())).await;
+    h.inject_flood_block(0, rows as u64).await;
+    h.wait_loc_rib_exact(rows, CONVERGENCE_TIMEOUT).await;
+    if warm {
+        h.wait_staged_exact(rows as u64, CONVERGENCE_TIMEOUT).await;
+        h.wait_drained_exact(rows as u64, CONVERGENCE_TIMEOUT).await;
+    }
+    let peer = PeerId::from_addr(client_addr(u32::from(warm)));
+    h.tx.send(RibUpdate::SetPeerExportEncoder {
+        peer,
+        session_id: 1,
+        encoder: fanout_bench_export_encoder(),
+    })
+    .await
+    .unwrap();
+    assert_eq!(count(&h.tx).await, rows);
+    assert_eq!(
+        RibManager::registration_measure_marker_ns().load(Ordering::Acquire),
+        0
+    );
+    let old_peak = actor_peak(&metrics);
+    let (otx, mut output) = mpsc::channel(CHANNEL_CAP);
+    let (ready_tx, ready_rx) = oneshot::channel();
+    let handle = tokio::runtime::Handle::current();
+    let primary = h.tx.clone();
+    let before_memory = memory();
+    let stop = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let sampler_stop = stop.clone();
+    let sampler = std::thread::spawn(move || {
+        let mut max = (0, 0);
+        let mut samples = 0;
+        while !sampler_stop.load(Ordering::Acquire) {
+            if probe::building() {
+                let (rss, scope) = memory();
+                if probe::building() {
+                    max = (max.0.max(rss), max.1.max(scope));
+                    samples += 1;
+                }
+            }
+            std::thread::sleep(Duration::from_millis(2));
+        }
+        (max, samples)
+    });
+    let worker = std::thread::spawn(move || {
+        let source = source_addr(INGRESS_FLOOD);
+        let message = empty_routes_received(
+            IpAddr::V4(source),
+            vec![route(marker(), source, marker_pref)],
+        );
+        ready_tx.send(()).unwrap();
+        let t0 = Instant::now();
+        while !(if warm {
+            probe::started()
+        } else {
+            probe::first_work_started()
+        }) {
+            assert!(
+                t0.elapsed() < CONVERGENCE_TIMEOUT,
+                "registration owner never entered"
+            );
+            std::thread::sleep(Duration::from_micros(20));
+        }
+        let attempt = probe::now_ns();
+        let permit = handle.block_on(primary.reserve()).unwrap();
+        let before = probe::now_ns();
+        permit.send(message);
+        let after = probe::now_ns();
+        (attempt, before, after)
+    });
+    ready_rx.await.unwrap();
+    probe::arm(peer);
+    let join_permit = h.tx.reserve().await.unwrap();
+    let join_before = probe::now_ns();
+    join_permit.send(target(peer, otx));
+    let join_after = probe::now_ns();
+
+    let mut receiver = Receiver::new(rows, marker_pref, sliced);
+    while !receiver.marker || receiver.eor == 0 {
+        let event = tokio::time::timeout(CONVERGENCE_TIMEOUT, output.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        receiver.fold(&event);
+    }
+    assert_eq!(count(&h.tx).await, rows + 1);
+    let (attempt, before, after) = worker.join().unwrap();
+    let handler = RibManager::registration_measure_handler_ns().load(Ordering::Acquire);
+    let installed = RibManager::registration_measure_marker_ns().load(Ordering::Acquire);
+    let measurement = tokio::time::timeout(CONVERGENCE_TIMEOUT, async {
+        loop {
+            if let Some(o) = probe::take() {
+                return o;
+            }
+            tokio::time::sleep(Duration::from_millis(1)).await;
+        }
+    })
+    .await
+    .unwrap();
+    let peak = actor_peak(&metrics);
+    let group = h.peer_update_group(peer.addr()).await;
+    assert!(group.starts_with("group:"));
+    if warm {
+        assert_eq!(group, h.peer_update_group(client_addr(0)).await);
+    }
+    let staged = h.staged_counts().await;
+    assert_eq!(staged[&peer.addr()], (rows + 1) as u64);
+    while let Ok(extra) = output.try_recv() {
+        receiver.fold(&extra);
+    }
+
+    stop.store(true, Ordering::Release);
+    let ((build_rss, build_scope), samples) = sampler.join().unwrap();
+    let settled = memory();
+    println!("registration_memory preload_rss_kib={} preload_scope_bytes={} build_sampled_rss_kib={build_rss} build_sampled_scope_bytes={build_scope} build_samples={samples} settled_rss_kib={} settled_scope_bytes={}", before_memory.0,before_memory.1,settled.0,settled.1);
+    if wrong {
+        assert_eq!(
+            (handler, installed),
+            (0, 0),
+            "wrong marker value matched observer"
+        );
+        assert_eq!(
+            (receiver.base, receiver.eor, receiver.marker),
+            (rows, 1, true)
+        );
+        println!("registration_control mode=wrong rows={rows} base_seen={} eor={} marker_before_eor={} wrong_value_delivered=true handler_ns={handler} installed_ns={installed} result=expected_rejection",receiver.base,receiver.eor,receiver.marker_before_eor);
+        return;
+    }
+    let o = measurement;
+    let enqueue = RibManager::registration_measure_first_enqueue_ns().load(Ordering::Acquire);
+    println!("registration_raw mode={mode} arm={arm} rows={rows} registration_admit_before_ns={join_before} registration_admit_after_ns={join_after} owner_start_ns={} owner_end_ns={} poll_start_ns={} poll_end_ns={} attempt_ns={attempt} admit_before_ns={before} admit_after_ns={after} handler_ns={handler} installed_ns={installed} first_enqueue_ns={enqueue} build_start_ns={} build_end_ns={} map_insert_ns={} published_ns={} replay_start_ns={} replay_end_ns={} install_end_ns={} deferred={} readiness_owned={}",o.owner_start_ns,o.owner_end_ns,o.poll_start_ns,o.poll_end_ns,o.build_start_ns,o.build_end_ns,o.map_insert_ns,o.published_ns,o.replay_start_ns,o.replay_end_ns,o.install_end_ns,o.deferred,o.readiness_owned);
+    assert!(
+        o.poll_start_ns <= o.owner_start_ns
+            && o.owner_start_ns <= attempt
+            && attempt <= before
+            && before <= after
+            && after <= handler
+            && handler <= installed,
+        "INVALID: marker handoff outside registration or after actor receipt"
+    );
+    assert!(join_before <= join_after && join_before <= o.owner_start_ns && join_after <= o.owner_end_ns);
+    assert!(o.readiness_owned && o.owner_end_ns <= o.poll_end_ns);
+    assert_eq!(o.loc_rows, rows);
+    let opening = rows + usize::from(sliced);
+    assert_eq!((o.replay_rows, o.replay_visited), (opening, opening));
+    assert!(o.replay_start_ns > 0 && o.replay_end_ns <= enqueue && enqueue <= o.owner_end_ns);
+    if !warm {
+        assert!(
+            o.build_start_ns <= attempt && after <= o.published_ns && o.published_ns <= enqueue
+        );
+    }
+    if sliced {
+        assert!(installed < o.published_ns && o.published_ns <= o.replay_start_ns);
+        assert!(o.build_only_poll_count > 0);
+    } else {
+        assert!(o.owner_end_ns <= handler);
+        let n = if warm { 0 } else { rows };
+        assert_eq!((o.collected_rows, o.staged_rows, o.retired_keys), (n, n, n));
+    }
+    assert!(
+        peak >= o.max_actor_poll_ns / 1000,
+        "production actor metric missed measured poll"
+    );
+    println!("registration_work loc_keys={} collect_keys={} stage_keys={} retired_keys={} discovery_visits={} repair_keys={} cleanup_visits={} stage_deltas={} build_polls={} build_only_polls={} max_poll_visits={} max_poll_discovery={} max_poll_repairs={} max_poll_staged={} max_poll_retired={} max_buffer_keys={} max_changed_keys={} max_provisional_tables={} replay_visited={} replay_rows={}",o.loc_rows,o.collected_rows,o.staged_rows,o.retired_keys,o.discovery_visits,o.repair_keys,o.cleanup_visits,o.stage_deltas,o.build_poll_count,o.build_only_poll_count,o.max_poll_visits,o.max_poll_discovery,o.max_poll_repairs,o.max_poll_staged,o.max_poll_retired,o.max_buffer_keys,o.max_changed_keys,o.max_provisional_tables,o.replay_visited,o.replay_rows);
+    println!("registration_result mode={mode} arm={arm} rows={rows} build_wall_ns={} build_active_ns={} max_build_only_poll_ns={} replay_poll_ns={} replay_traversal_ns={} initial_replay_ns={} registration_ns={} registration_handoff_lower_ns={} registration_handoff_upper_ns={} max_actor_poll_ns={} actor_max_us={peak} pre_actor_max_us={old_peak} admission_wait_ns={} admit_to_install_lower_ns={} admit_to_install_upper_ns={} admit_to_handler_lower_ns={} admit_to_handler_upper_ns={} handler_to_install_ns={} base_seen={} marker_seen={} marker_before_eor={} eor={} final_loc={} final_staged={} group={group}",
+        o.build_end_ns-o.build_start_ns,o.build_active_ns,o.max_build_only_poll_ns,o.replay_poll_ns,o.replay_end_ns-o.replay_start_ns,o.owner_end_ns-o.install_end_ns,o.owner_end_ns-o.owner_start_ns,o.owner_end_ns-join_after,o.owner_end_ns-join_before,o.max_actor_poll_ns,before-attempt,installed-after,installed-before,handler-after,handler-before,installed-handler,receiver.base,receiver.marker,receiver.marker_before_eor,receiver.eor,rows+1,staged[&peer.addr()]);
+}
+
+fn memory() -> (u64, u64) {
+    // Off-actor snapshots; whole-process high-water and cgroup.peak come from the launcher.
+    let status = std::fs::read_to_string("/proc/self/status").unwrap();
+    let rss = status
+        .lines()
+        .find_map(|line| line.strip_prefix("VmRSS:"))
+        .unwrap()
+        .split_whitespace()
+        .next()
+        .unwrap()
+        .parse()
+        .unwrap();
+    let cg = std::fs::read_to_string("/proc/self/cgroup").unwrap();
+    let dir = cg.lines().find_map(|l| l.strip_prefix("0::")).unwrap();
+    let bytes = std::fs::read_to_string(format!("/sys/fs/cgroup{dir}/memory.current"))
+        .unwrap()
+        .trim()
+        .parse()
+        .unwrap();
+    (rss, bytes)
+}
