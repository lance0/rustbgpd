+/// Local scout instrumentation: where the max gap sits, relative to SIGHUP.
+fn scout_gap_line(ctx: &Ctx, r: u32, i: usize, s_us: u64, e_us: u64) {
+    let ev = ctx.obs[i].events.lock().unwrap();
+    let (mut last, mut best, mut bs, mut be, mut be_base, mut n_pre, mut first_base) =
+        (s_us, 0u64, s_us, s_us, 0u32, 0u32, None::<u64>);
+    let (mut n_base_upd, mut n_all_upd) = (0u32, 0u32);
+    for e in ev.iter().filter(|e| e.t_us >= s_us && e.t_us <= e_us) {
+        n_all_upd += 1;
+        if e.base_ann > 0 {
+            n_base_upd += 1;
+        }
+        if e.base_ann > 0 && first_base.is_none() {
+            first_base = Some(e.t_us);
+        }
+        if first_base.is_none() {
+            n_pre += 1;
+        }
+        if e.t_us - last > best {
+            (best, bs, be, be_base) = (e.t_us - last, last, e.t_us, e.base_ann);
+        }
+        last = e.t_us;
+    }
+    let ms = |t: u64| (t - s_us) as f64 / 1000.0;
+    println!(
+        "scout_gap,{r},{i},{:.3},{:.3},{:.3},{be_base},{n_pre},{:.3},{:.3},{n_base_upd},{n_all_upd}",
+        best as f64 / 1000.0,
+        ms(bs),
+        ms(be),
+        first_base.map_or(f64::NAN, ms),
+        ms(e_us)
+    );
+}
