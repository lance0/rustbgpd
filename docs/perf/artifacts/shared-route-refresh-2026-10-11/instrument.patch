+    #[tokio::test]
+    async fn rr_refresh_stamp_waits_for_the_complete_frame_and_refuses_failed_write() {
+        tokio::time::timeout(Duration::from_secs(2), async {
+            let ctx = finish_test_ctx();
+            let (mut writer, mut reader) = tokio::io::duplex(1);
+            let message = Message::RouteRefresh(RouteRefreshMessage::new(Afi::Ipv4, Safi::Unicast));
+            let expected = encode_message(&message).unwrap();
+            let bytes = expected.clone();
+            let (written, mut receipt) = tokio::sync::oneshot::channel();
+            let before = now_us(&ctx);
+            let writer_ctx = Arc::clone(&ctx);
+            let task = tokio::spawn(async move {
+                write_and_stamp(&mut writer, &bytes, Some(written), &writer_ctx).await
+            });
+            let mut first = [0];
+            reader.read_exact(&mut first).await.unwrap();
+            assert_eq!(first[0], expected[0]);
+            assert!(
+                matches!(
+                    receipt.try_recv(),
+                    Err(tokio::sync::oneshot::error::TryRecvError::Empty)
+                ),
+                "one byte read cannot acknowledge the still-blocked remainder"
+            );
+            let mut remainder = vec![0; expected.len() - 1];
+            reader.read_exact(&mut remainder).await.unwrap();
+            assert_eq!(remainder, expected[1..]);
+            let at = receipt.await.unwrap();
+            assert!(before <= at && at <= now_us(&ctx));
+            task.await.unwrap().unwrap();
+
+            let (mut writer, reader) = tokio::io::duplex(1);
+            drop(reader);
+            let (written, receipt) = tokio::sync::oneshot::channel();
+            assert!(write_and_stamp(&mut writer, &expected, Some(written), &ctx)
+                .await
+                .is_err());
+            assert!(
+                receipt.await.is_err(),
+                "failed write cannot publish a successful stamp"
+            );
+        })
+        .await
+        .unwrap();
+    }
