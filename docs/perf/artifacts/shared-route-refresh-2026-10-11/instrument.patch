+
+fn validate_rr_refresh(progress: &RejoinProgress, queued: u64) -> Result<(), String> {
+    let first = progress
+        .table
+        .first_marker_base_at_us
+        .ok_or("no fresh base UPDATE")?;
+    let table = progress
+        .table
+        .completed_at_us
+        .ok_or("no fresh table completion")?;
+    let eor = progress.eor_us.ok_or("no fresh EoR")?;
+    let complete = progress.complete_us.ok_or("no refresh completion")?;
+    if progress.table.unique != progress.table.target {
+        return Err("incomplete current RR table".into());
+    }
+    if (progress.table.excluded_start..progress.table.excluded_end)
+        .any(|i| progress.table.received[i / 64] & (1u64 << (i % 64)) != 0)
+    {
+        return Err("RR delivered an excluded own-source prefix".into());
+    }
+    if queued > progress.open_sent_us
+        || queued > first
+        || first > table
+        || queued > eor
+        || table > eor
+        || progress.open_sent_us >= complete
+        || complete != table.max(eor)
+    {
+        return Err("invalid requested-refresh clock ordering".into());
+    }
+    Ok(())
+}
