+/// Opt-in terminal RR cell. The existing fresh table/EoR tracker is armed
+/// before any request, and each clock begins only after its successful write.
+async fn run_rr_refresh(
+    ctx: &Arc<Ctx>,
+    stubs: &[Stub],
+    k: u32,
+    rounds: u32,
+    pid: i32,
+    addr: SocketAddr,
+) -> Result<(), String> {
+    let withdrawn: Vec<u64> = ctx
+        .obs
+        .iter()
+        .map(|o| o.base_withdrawn.load(Ordering::Relaxed))
+        .collect();
+    // Initial OPEN tracking must have consumed the initial snapshot's EoR;
+    // it must not be mistaken for the first requested refresh's EoR.
+    wait_rejoin_completion(ctx, 0, k, 0).await;
+    if !current_rejoin_tables_complete(ctx, 0, k) {
+        return Err("initial RR table/EoR proof incomplete".into());
+    }
+    disarm_survivors(ctx, 0);
+    println!("rr_refresh_csv_header,round,peers_total,refreshers,prefixes,completion_p50_s,completion_max_s,survivor_maxgap_ms,readiness_samples,rss_mib,sessions_up,parse_errors,window_start_us,window_end_us");
+    for round in 1..=rounds {
+        converged_integrity(ctx, 0, &withdrawn, false)?;
+        drain_cycle_events(&ctx.obs);
+        ctx.rr_gap_only.store(true, Ordering::Release);
+        ctx.record_events.store(true, Ordering::Release);
+        // All fresh trackers are reset before the first request is queued.
+        for i in 0..k {
+            let mut progress = RejoinProgress::new(ctx, i, 0);
+            progress.require_eor = true;
+            *ctx.obs[i as usize].rejoin.lock().unwrap() = Some(progress);
+        }
+        let (stop, stopped) = tokio::sync::oneshot::channel();
+        let readiness = tokio::spawn(watch_readiness(
+            addr,
+            stopped,
+            Some((Arc::clone(ctx), round)),
+        ));
+        let window_start = now_us(ctx);
+        let deadline = tokio::time::Instant::now() + STALL_WINDOW;
+        let mut writes = Vec::with_capacity(k as usize);
+        for (i, stub) in stubs.iter().enumerate().take(k as usize) {
+            let queued = now_us(ctx);
+            let (written, receipt) = tokio::sync::oneshot::channel();
+            tokio::time::timeout_at(
+                deadline,
+                stub.tx.send(Outbound {
+                    message: Message::RouteRefresh(RouteRefreshMessage::new(
+                        Afi::Ipv4,
+                        Safi::Unicast,
+                    )),
+                    replay: None,
+                    written: Some(written),
+                }),
+            )
+            .await
+            .map_err(|_| format!("refresh {i} enqueue timed out"))?
+            .map_err(|_| format!("refresh {i} writer closed"))?;
+            writes.push((queued, receipt));
+        }
+        // Every request is enqueued before waiting for any write or response.
+        let mut queued_times = Vec::with_capacity(k as usize);
+        for (i, (queued, receipt)) in writes.into_iter().enumerate() {
+            let written = tokio::time::timeout_at(deadline, receipt)
+                .await
+                .map_err(|_| format!("refresh {i} socket write timed out"))?
+                .map_err(|_| format!("refresh {i} socket write failed"))?;
+            ctx.obs[i]
+                .rejoin
+                .lock()
+                .unwrap()
+                .as_mut()
+                .unwrap()
+                .open_sent_us = written;
+            queued_times.push(queued);
+        }
+        let values = wait_rejoin_completion(ctx, 0, k, round).await;
+        if !current_rejoin_tables_complete(ctx, 0, k) {
+            return Err("fresh RR table/EoR proof incomplete".into());
+        }
+        converged_integrity(ctx, 0, &withdrawn, false)?;
+        let mut window_end = window_start;
+        for (i, &queued) in queued_times.iter().enumerate() {
+            let guard = ctx.obs[i].rejoin.lock().unwrap();
+            let progress = guard.as_ref().unwrap();
+            validate_rr_refresh(progress, queued)
+                .map_err(|error| format!("refresh peer {i}: {error}"))?;
+            let written = progress.open_sent_us;
+            let first = progress.table.first_marker_base_at_us.unwrap();
+            let table = progress.table.completed_at_us.unwrap();
+            let eor = progress.eor_us.unwrap();
+            let complete = progress.complete_us.unwrap();
+            window_end = window_end.max(complete);
+            println!("rr_refresh_peer,round={round},peer={i},queue_attempt_us={queued},written_us={written},first_base_us={first},table_us={table},eor_us={eor},complete_us={complete},unique={},expected={},completion_s={:.6}",
+                progress.table.unique, progress.table.target, (complete - written) as f64 / 1e6);
+        }
+        ctx.record_events.store(false, Ordering::Release);
+        let _ = stop.send(());
+        let samples = readiness
+            .await
+            .map_err(|e| format!("readiness task: {e}"))??;
+        if samples == 0 {
+            return Err("no readiness samples".into());
+        }
+        converged_integrity(ctx, 0, &withdrawn, false)?;
+        for (i, &queued) in queued_times.iter().enumerate() {
+            let mut guard = ctx.obs[i].rejoin.lock().unwrap();
+            validate_rr_refresh(guard.as_ref().unwrap(), queued)
+                .map_err(|error| format!("final refresh peer {i}: {error}"))?;
+            // Freeze this terminal proof under the same lock that validates
+            // it, so an UPDATE during the readiness join cannot escape it.
+            *guard = None;
+        }
+        let completion = stats_line(&format!("rr_refresh {round} completion_s"), values);
+        let gap = stats_line(
+            &format!("rr_refresh {round} survivor_maxgap_ms"),
+            (k as usize..ctx.obs.len())
+                .map(|i| max_gap_ms(ctx, i, window_start, window_end, true))
+                .collect(),
+        );
+        let up = ctx
+            .obs
+            .iter()
+            .filter(|o| o.established.load(Ordering::Relaxed))
+            .count();
+        println!("rr_refresh_csv,{round},{},{k},{},{:.6},{:.6},{:.6},{samples},{},{up},{},{window_start},{window_end}",
+            ctx.n_peers, ctx.totals[0], completion.p50, completion.max, gap.max,
+            rss_mib(pid), ctx.parse_errors.load(Ordering::Relaxed));
+        if round < rounds {
+            tokio::time::sleep(Duration::from_secs(10)).await;
+        }
+    }
+    Ok(())
+}
