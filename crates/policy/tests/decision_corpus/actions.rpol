# Decision-corpus programs: branch shapes and the actions no other program
# in the tree exercises, each pinned by tests.

policy branches {
    term t {
        if route.med >= 100 {
            if route.local-pref >= 200 { set med 1 } else { set med 2 }
        } else {
            set med 3
        }
        accept
    }
}

policy next-hop-rewrite {
    term own { if route.prefix == 192.0.2.0/24 { set next-hop self; accept } }
    term fixed { set next-hop 198.51.100.254; accept }
}

policy computed-prepend {
    term t { prepend as peer 2; accept }
}

policy tag-and-scrub {
    term t {
        add large-community 65000:1:2
        remove ext-community RT:65000:1
        accept
    }
}

test nested-then {
    route { prefix 192.0.2.0/24; med 100; local-pref 200 }
    expect branches == accept with med 1
}
test nested-else {
    route { prefix 192.0.2.0/24; med 100; local-pref 100 }
    expect branches == accept with med 2
}
test outer-else {
    route { prefix 192.0.2.0/24; med 50 }
    expect branches == accept with med 3
}
test next-hop-self {
    route { prefix 192.0.2.0/24 }
    expect next-hop-rewrite == accept with next-hop self
}
test next-hop-address {
    route { prefix 198.51.100.0/24 }
    expect next-hop-rewrite == accept with next-hop 198.51.100.254
}
test prepend-peer {
    route { prefix 192.0.2.0/24; as-path "64500" }
    peer { asn 64500 }
    expect computed-prepend == accept with prepend as 64500 2
}
test tag-and-scrub {
    route { prefix 192.0.2.0/24; ext-communities [RT:65000:1, RT:65000:2] }
    expect tag-and-scrub == accept with large-community 65000:1:2,
        removes ext-community RT:65000:1, not removed ext-community RT:65000:2
}

community-set route-targets { RT:65000:* }
community-set own-large { 65000:*:* }

policy scrub-by-set {
    term t {
        remove ext-community not in route-targets
        remove large-community in own-large
        accept
    }
}

test scrub-by-set {
    route {
        prefix 192.0.2.0/24
        ext-communities [RT:65000:1, RT:64496:1, OV_VALID]
        large-communities [65000:1:1, 64496:1:1]
    }
    expect scrub-by-set == accept with only removes ext-community RT:64496:1,
        removes large-community 65000:1:1, not removed ext-community RT:65000:1,
        not removed ext-community OV_VALID, not removed large-community 64496:1:1
}

# Typed parameters: a `community` parameter in `has`, an `ip` parameter as
# the next hop, and a `community-set` parameter as a removal set.
community-set scrub-tags { 65000:666 }

policy tag-forward(tag: community, nh: ip, scrub: community-set) {
    term tagged {
        if route.communities has tag {
            remove community in scrub
            set next-hop nh
            accept
        }
    }
    term rest { reject }
}

test tag-forward-hit {
    route { prefix 192.0.2.0/24; communities [65000:7, 65000:666] }
    expect tag-forward(65000:7, 192.0.2.9, scrub-tags) == accept with next-hop 192.0.2.9,
        removes community 65000:666, not removed community 65000:7
}

test tag-forward-miss {
    route { prefix 192.0.2.0/24; communities [65000:8] }
    expect tag-forward(65000:7, 192.0.2.9, scrub-tags) == reject
}

# A computed `set` and a literal `set` share their attribute's slot, so the
# later one wins in either order: in a term, in a loop body, and across an
# applied policy's inlined terms.
policy literal-after-computed {
    term t {
        set med route.med + 5
        set med 10
        set local-pref min(route.local-pref * 2, 400)
        set local-pref 200
        accept
    }
}

policy computed-after-literal {
    term t {
        set med 10
        set med route.med + 5
        set local-pref 200
        set local-pref min(route.local-pref * 2, 400)
        accept
    }
}

policy loop-literal-after-computed {
    term t {
        for c in route.communities {
            set med route.med + 5
            set med 10
            set local-pref route.local-pref + 1
            set local-pref 200
        }
        accept
    }
}

policy bump-med {
    term t { set med route.med + 5; set local-pref route.local-pref * 2 }
}

policy pin-med {
    term t { set med 10; set local-pref 200 }
}

policy literal-after-applied-computed {
    term t {
        apply bump-med
        set med 10
        set local-pref 200
        accept
    }
}

policy applied-literal-after-computed {
    term t {
        set med route.med + 5
        set local-pref route.local-pref * 2
        apply pin-med
        accept
    }
}

policy child-literal-after-computed {
    term t {
        set med route.med + 5
        set med 10
        set local-pref route.local-pref * 2
        set local-pref 200
    }
}

policy applies-literal-after-computed {
    term t { apply child-literal-after-computed; accept }
}

test literal-set-replaces-computed-set {
    route { prefix 192.0.2.0/24; med 100; local-pref 150 }
    expect literal-after-computed == accept with med 10, local-pref 200
}
test computed-set-replaces-literal-set {
    route { prefix 192.0.2.0/24; med 100; local-pref 150 }
    expect computed-after-literal == accept with med 105, local-pref 300
}
test loop-literal-set-replaces-computed-set {
    route { prefix 192.0.2.0/24; med 100; local-pref 150; communities [65000:1] }
    expect loop-literal-after-computed == accept with med 10, local-pref 200
}
test literal-set-replaces-applied-computed-set {
    route { prefix 192.0.2.0/24; med 100; local-pref 150 }
    expect literal-after-applied-computed == accept with med 10, local-pref 200
}
test applied-literal-set-replaces-computed-set {
    route { prefix 192.0.2.0/24; med 100; local-pref 150 }
    expect applied-literal-after-computed == accept with med 10, local-pref 200
}
test applied-policy-literal-set-replaces-computed-set {
    route { prefix 192.0.2.0/24; med 100; local-pref 150 }
    expect applies-literal-after-computed == accept with med 10, local-pref 200
}

# A computed `set` that would fail closed on a route without the operand
# (no origin AS on an empty path) is replaced by the later literal, so the
# route is accepted rather than denied.
policy literal-after-fail-closed {
    term t {
        set med route.origin-as
        set med 10
        accept
    }
}

test literal-set-replaces-fail-closed-computed-set {
    route { prefix 192.0.2.0/24 }
    expect literal-after-fail-closed == accept with med 10
}
