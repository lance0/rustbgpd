# GENERATED by rs-config-render — do not edit; edits are overwritten on the
# next refresh. Regenerate from `arouteserver template-context` output.
# Shared import hygiene. Context-shape fingerprint: 6cf0b6c6d60bb276.
#
# Ordering contract: this policy is the first member of every client's
# import chain and its first term rejects AS_SET segments, so per-client
# origin enforcement (`route.origin-as in ...`) is never evaluated on a
# path that still carries an AS_SET.

asn-set rs-transit-free-asns { 174, 3356 }
prefix-set rs-bogon-prefixes {
    10.0.0.0/8 le 32,  # RFC 1918
    192.168.0.0/16 le 32,  # RFC 1918
    fc00::/7 le 128,  # unique local
}
prefix-set rs-black-list-prefixes {
    192.0.2.0/24 le 32,  # IXP peering LAN
}
prefix-set rs-v4-len-outside-window {
    0.0.0.0/0 le 7,
    0.0.0.0/0 ge 25,
}
prefix-set rs-v6-len-outside-window {
    ::/0 le 11,
    ::/0 ge 49,
}

policy rs-hygiene {
    # AS_SET segments render in braces ("65001 {65002 65003}").
    term reject-as-set { if route.as-path matches "\\{" { reject } }
    # 0, AS_TRANS, 16-bit doc/private/reserved (64496-65551), and the
    # 32-bit private+reserved range (any 10-digit "42..." ASN in u32).
    term reject-invalid-asn { if route.as-path matches "_(0|23456|6449[6-9]|64[5-9][0-9][0-9]|65[0-4][0-9][0-9]|655[0-4][0-9]|6555[01]|42[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])_" { reject } }
    # A transit-free network in the path of a route learned from anyone
    # but that network itself means someone is leaking transit through it.
    term reject-transit-free-in-path {
        if !(peer.asn in rs-transit-free-asns) && route.as-path matches "_(174|3356)_" { reject }
    }
    # PeeringDB never-via-route-servers networks.
    term reject-never-via-rs { if route.as-path matches "_(39999)_" { reject } }
    term reject-long-as-path { if route.as-path.len >= 33 { reject } }
    term reject-bogon-prefix { if route.prefix in rs-bogon-prefixes { reject } }
    term reject-black-list-prefix { if route.prefix in rs-black-list-prefixes { reject } }
    # Accepted v4 prefix lengths: 8-24.
    term reject-v4-len-outside-window { if route.prefix in rs-v4-len-outside-window { reject } }
    # Accepted v6 prefix lengths: 12-48.
    term reject-v6-len-outside-window { if route.prefix in rs-v6-len-outside-window { reject } }
    term reject-rpki-invalid { if route.rpki == invalid { reject } }
    # RFC 8097 origin-validation extended communities for members.
    term tag-ov-valid { if route.rpki == valid { add ext-community OV_VALID } }
    term tag-ov-not-found { if route.rpki == not-found { add ext-community OV_NOT_FOUND } }
}

# In-language tests, run by `rbgp policy check`.
test as-set-path-is-rejected {
    route { prefix 203.0.113.0/24; as-path "3333 {65010 65011}" }
    expect rs-hygiene == reject
}
test private-16bit-asn-in-path-is-rejected {
    route { prefix 203.0.113.0/24; as-path "3333 64512" }
    expect rs-hygiene == reject
}
test private-32bit-asn-in-path-is-rejected {
    route { prefix 203.0.113.0/24; as-path "3333 4210000000" }
    expect rs-hygiene == reject
}
test overlong-as-path-is-rejected {
    route { prefix 203.0.113.0/24; as-path "3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333 3333" }
    expect rs-hygiene == reject
}
test v4-default-route-is-rejected {
    route { prefix 0.0.0.0/0 }
    expect rs-hygiene == reject
}
test v6-default-route-is-rejected {
    route { prefix ::/0 }
    expect rs-hygiene == reject
}
test rpki-invalid-is-rejected {
    route { prefix 203.0.113.0/24; as-path "3333"; rpki invalid }
    expect rs-hygiene == reject
}
