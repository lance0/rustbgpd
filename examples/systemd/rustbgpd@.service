[Unit]
Description=rustbgpd BGP daemon (%i)
Documentation=man:rustbgpd(8) https://github.com/lance0/rustbgpd
After=network-online.target
Wants=network-online.target
# Bound repeated fail-stop recovery: five starts per ten-minute window.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=10min
ExecStart=/usr/local/bin/rustbgpd /var/lib/rustbgpd/%i/activation/current/config.toml
ExecReload=/bin/kill -HUP $MAINPID
# READY=1 arrives once the configured peer roster is installed and BGP
# ingress is active; STOPPING=1 marks the start of coordinated shutdown.
# WATCHDOG=1 follows each liveness sample, taken every 10 seconds, in which
# the PeerManager and RIB actors both answered within 5 seconds. A RIB that
# answers "stalled" from inside a long unit of work fails /readyz but is
# still pinged. PID 1 independently enforces the deadline: it aborts the
# daemon about five minutes (285 to 305 seconds) after an actor stops
# answering.
# Restart=on-failure below covers watchdog expiry.
WatchdogSec=5min
# Watchdog expiry sends SIGABRT, which the daemon does not handle, so the
# kernel writes a core dump before the process exits. Every session is
# already lost and the restart waits for the dump, so the wait is bounded:
# two minutes is enough for a multi-gigabyte core, and SIGKILL truncates a
# larger one. Unset, the wait would fall back to TimeoutStopSec (32 minutes).
TimeoutAbortSec=2min

User=rustbgpd
Group=rustbgpd

# Keep each IXP Manager handle's daemon and activation state private.
StateDirectory=rustbgpd/%i rustbgpd/%i/activation
StateDirectoryMode=0700
RuntimeDirectory=rustbgpd/%i
RuntimeDirectoryMode=0700
UMask=0077

# Security hardening. The shared lifecycle host fence is intentionally
# outside this daemon's writable namespace.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rustbgpd/%i
PrivateTmp=yes

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=5
TimeoutStopSec=32min

[Install]
WantedBy=multi-user.target
