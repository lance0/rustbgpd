[Unit]
Description=rustbgpd BGP daemon
Documentation=man:rustbgpd(8) https://github.com/lance0/rustbgpd
After=network-online.target
Wants=network-online.target
# Bound repeated fail-stop recovery: five starts per ten-minute window.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=10min
# --runtime-state-dir must match the config's runtime_state_dir; the daemon
# refuses to start otherwise, so the stop hook below always reads the
# directory the daemon wrote.
ExecStart=/usr/local/bin/rustbgpd --runtime-state-dir /var/lib/rustbgpd /etc/rustbgpd/config.toml
ExecReload=/bin/kill -HUP $MAINPID
# EVPN core-isolation hold: after any exit, raise the CE-facing links the
# daemon took down. Reads only the ownership receipt, never the config; exits
# 0 when there is nothing to release.
ExecStopPost=/usr/local/bin/rustbgpd --release-core-isolation --runtime-state-dir /var/lib/rustbgpd
# READY=1 arrives once the configured peer roster is installed and BGP
# ingress is active; STOPPING=1 marks the start of coordinated shutdown.
# WATCHDOG=1 is sent every 2.5 minutes only while the PeerManager and RIB
# actors answer the same bounded core-actor probe /readyz uses. PID 1
# independently enforces the five-minute watchdog deadline;
# Restart=on-failure below covers watchdog expiry.
WatchdogSec=5min

# Unprivileged service user. Create it once:
#   useradd --system --home-dir /var/lib/rustbgpd --shell /usr/sbin/nologin rustbgpd
User=rustbgpd
Group=rustbgpd

# State directory for GR restart markers, gRPC UDS, config persistence
StateDirectory=rustbgpd
RuntimeDirectory=rustbgpd

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rustbgpd /etc/rustbgpd
PrivateTmp=yes

# Unprivileged default: CAP_NET_BIND_SERVICE only (bind port 179 as
# non-root). This covers route-reflector / control-plane-only
# deployments. Kernel-dataplane features ([[fib_tables]], blackhole
# install, EVPN VTEP/IRB) additionally need CAP_NET_ADMIN — enable the
# rustbgpd-dataplane.conf drop-in shipped next to this unit instead of
# widening these lines.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Restart on failure, but not on clean shutdown (exit 0) or SIGTERM
Restart=on-failure
RestartSec=5
# An owned runtime-config mutation may need its full 30-minute settlement
# watchdog plus the five-second fail-stop grace during an explicit stop.
TimeoutStopSec=32min

[Install]
WantedBy=multi-user.target
