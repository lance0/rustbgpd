# Official GoBGP 4.x linux/amd64 release binaries, checksum-pinned per image.
# CI builds 4.6.0 (gobgp:bgpls), 4.7.0 (M92) and 4.8.0 by passing
# GOBGP_VERSION and GOBGP_SHA256 build arguments.
FROM debian:bookworm-slim AS gobgp-release

ARG GOBGP_VERSION=4.7.0
ARG GOBGP_SHA256=05d98ca0d7bbcb2f50a6b7b6ee51c5e5b5fd64d6a310ee807040ed9d7104d5e0
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# CI stages the cache-restored or upstream-fetched, checksum- and
# version-verified release archive here (.github/actions/stage-gobgp-artifact)
# so hosted builds never contact the upstream release. The committed directory
# is empty, which keeps cold local builds on the bounded in-build fetch below.
COPY gobgp-archive/ /tmp/gobgp-archive/

RUN set -eux; \
    test "${TARGETARCH}" = amd64; \
    archive="/tmp/gobgp-archive/gobgp_${GOBGP_VERSION}_linux_amd64.tar.gz"; \
    if [ ! -f "${archive}" ]; then \
        curl -fsSLo "${archive}" \
            --connect-timeout 10 --max-time 120 \
            --retry 5 --retry-all-errors --retry-delay 5 --retry-max-time 180 \
            "https://github.com/osrg/gobgp/releases/download/v${GOBGP_VERSION}/gobgp_${GOBGP_VERSION}_linux_amd64.tar.gz"; \
    fi; \
    echo "${GOBGP_SHA256}  ${archive}" | sha256sum --check --strict; \
    tar -xzf "${archive}" -C /usr/local/bin gobgp gobgpd; \
    test "$(gobgp --version)" = "gobgp version ${GOBGP_VERSION}"; \
    test "$(gobgpd --version)" = "gobgpd version ${GOBGP_VERSION}"

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=gobgp-release /usr/local/bin/gobgpd /usr/local/bin/gobgpd
COPY --from=gobgp-release /usr/local/bin/gobgp /usr/local/bin/gobgp

CMD ["sleep", "infinity"]
