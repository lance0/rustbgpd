# M83 — IXP import hygiene (the examples/route-server hygiene.rpol
# shape). Referenced from rustbgpd-m83-rs.toml via `[policy]
# rpol_files` and the import chain. The driver copies this next to
# /tmp/config.toml; the policy-reload stability phase edits the copy
# and SIGHUPs.

policy ixp-hygiene {
    # Reject routes carrying an AS_SET (deprecated by RFC 9774).
    # AS_PATHs render AS_SETs in braces, so a literal `{` matches any
    # AS_SET segment.
    term reject-as-set { if route.as-path matches "\\{" { reject } }
    # Reject ASPA-invalid AS paths. Inert (state = unknown) until ASPA
    # objects are loaded from the RPKI cache.
    term reject-aspa-invalid { if route.aspa == invalid { reject } }
}

test as-set-is-rejected {
    route { prefix 203.0.113.0/24; as-path "64501 {64502 64503}" }
    expect ixp-hygiene == reject
}

test clean-route-falls-through {
    route { prefix 203.0.113.0/24; as-path "64501 64510" }
    expect ixp-hygiene == accept
}
