# M120: two bundle interoperability members, sharing an RT and host MAC.
set / routing-policy prefix-set m120-withdraw-120 prefix 198.19.120.0/24 mask-length-range exact
set / routing-policy prefix-set m120-withdraw-120 prefix 198.19.120.2/32 mask-length-range exact
set / routing-policy policy m120-withdraw-120 default-action policy-result accept
set / routing-policy policy m120-withdraw-120 statement reject-120 match prefix prefix-set m120-withdraw-120
set / routing-policy policy m120-withdraw-120 statement reject-120 action policy-result reject
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.0.119.2/24
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 vlan-tagging true
set / interface ethernet-1/2 subinterface 10 type bridged
set / interface ethernet-1/2 subinterface 10 admin-state enable
set / interface ethernet-1/2 subinterface 10 vlan encap single-tagged vlan-id 10
set / interface ethernet-1/2 subinterface 20 type bridged
set / interface ethernet-1/2 subinterface 20 admin-state enable
set / interface ethernet-1/2 subinterface 20 vlan encap single-tagged vlan-id 20
set / interface system0 admin-state enable
set / interface system0 subinterface 0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 192.0.2.2/32
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface system0.0
set / tunnel-interface vxlan1 vxlan-interface 10 type bridged ingress vni 10010
set / tunnel-interface vxlan1 vxlan-interface 20 type bridged ingress vni 10020
set / network-instance bd10 type mac-vrf
set / network-instance bd10 admin-state enable
set / network-instance bd10 interface ethernet-1/2.10
set / network-instance bd10 vxlan-interface vxlan1.10
set / network-instance bd10 protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance bd10 protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.10
set / network-instance bd10 protocols bgp-evpn bgp-instance 1 evi 100
set / network-instance bd10 protocols bgp-evpn bgp-instance 1 routes bridge-table vlan-aware-bundle-eth-tag 10
set / network-instance bd10 protocols bgp-vpn bgp-instance 1 route-distinguisher rd 192.0.2.2:100
set / network-instance bd10 protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:100
set / network-instance bd10 protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:100
set / network-instance bd10 bridge-table static-mac mac 02:AA:BB:01:19:02 destination ethernet-1/2.10
set / network-instance bd20 type mac-vrf
set / network-instance bd20 admin-state enable
set / network-instance bd20 interface ethernet-1/2.20
set / network-instance bd20 vxlan-interface vxlan1.20
set / network-instance bd20 protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance bd20 protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.20
set / network-instance bd20 protocols bgp-evpn bgp-instance 1 evi 101
set / network-instance bd20 protocols bgp-evpn bgp-instance 1 routes bridge-table vlan-aware-bundle-eth-tag 20
set / network-instance bd20 protocols bgp-vpn bgp-instance 1 route-distinguisher rd 192.0.2.2:101
set / network-instance bd20 protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:100
set / network-instance bd20 protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:100
set / network-instance bd20 bridge-table static-mac mac 02:AA:BB:01:19:02 destination ethernet-1/2.20
set / network-instance default protocols bgp autonomous-system 65000
set / network-instance default protocols bgp router-id 10.0.119.2
set / network-instance default protocols bgp afi-safi evpn admin-state enable
set / network-instance default protocols bgp group rr peer-as 65000
# Without an explicit local-address SR Linux sources/accepts the session
# only on the system0 address (192.0.2.2 here) and rejects the connect
# from the RR: destination IP does not match the allowed local-address.
# NOTE: keep these comments free of apostrophes/quotes — sr_cli batch
# input treats an unbalanced quote as an open string and silently
# swallows every following line.
set / network-instance default protocols bgp group rr transport local-address 10.0.119.2
set / network-instance default protocols bgp group rr afi-safi evpn admin-state enable
set / network-instance default protocols bgp group rr afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp neighbor 10.0.119.1 peer-group rr
set / network-instance default protocols bgp neighbor 10.0.119.1 admin-state enable

# Interface-less IP-VRF Type 5 uses tag zero and a separate L3VNI.
set / interface irb0 admin-state enable
set / interface irb0 subinterface 10 admin-state enable
set / interface irb0 subinterface 10 ipv4 admin-state enable
set / interface irb0 subinterface 10 ipv4 address 198.18.10.253/24
set / network-instance bd10 interface irb0.10
set / interface irb0 subinterface 20 admin-state enable
set / interface irb0 subinterface 20 ipv4 admin-state enable
set / interface irb0 subinterface 20 ipv4 address 198.18.20.253/24
set / network-instance bd20 interface irb0.20
set / tunnel-interface vxlan1 vxlan-interface 50120 type routed ingress vni 50120
set / network-instance tenant type ip-vrf
set / network-instance tenant admin-state enable
set / network-instance tenant interface irb0.10
set / network-instance tenant interface irb0.20
set / network-instance tenant vxlan-interface vxlan1.50120
set / network-instance tenant protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance tenant protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.50120
set / network-instance tenant protocols bgp-evpn bgp-instance 1 evi 50120
set / network-instance tenant protocols bgp-vpn bgp-instance 1 route-distinguisher rd 192.0.2.2:50120
set / network-instance tenant protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:50120
set / network-instance tenant protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:50120
set / interface lo120 admin-state enable
set / interface lo120 subinterface 0 admin-state enable
set / interface lo120 subinterface 0 ipv4 admin-state enable
set / interface lo120 subinterface 0 ipv4 address 198.19.120.2/24
set / network-instance tenant interface lo120.0
set / interface lo123 admin-state enable
set / interface lo123 subinterface 0 admin-state enable
set / interface lo123 subinterface 0 ipv4 admin-state enable
set / interface lo123 subinterface 0 ipv4 address 198.19.123.2/24
set / network-instance tenant interface lo123.0
