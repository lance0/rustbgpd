@@ -0,0 +1,68 @@
+// Lab-only connection evidence for the M122 collision oracle.
+package server
+
+import (
+	"log/slog"
+	"net"
+	"os"
+	"sync"
+)
+
+// The owning FSM can use a different connection while closing a collision loser.
+type m122ConnectionTrace struct {
+	logger       *slog.Logger
+	id, sequence uint64
+	established  bool
+}
+
+var m122Trace = struct {
+	sync.Mutex
+	nextID      uint64
+	connections map[net.Conn]*m122ConnectionTrace
+}{connections: make(map[net.Conn]*m122ConnectionTrace)}
+
+// Callers hold m122Trace so event order and state are one snapshot.
+func m122Emit(conn net.Conn, trace *m122ConnectionTrace, event string) {
+	state := "pre_established"
+	if trace.established {
+		state = "established"
+	}
+	trace.sequence++
+	trace.logger.Info("M122 FSM trace",
+		slog.String("event", event), slog.String("tcp_local", conn.LocalAddr().String()),
+		slog.String("tcp_remote", conn.RemoteAddr().String()), slog.Int("process_id", os.Getpid()),
+		slog.Uint64("connection_id", trace.id), slog.Uint64("sequence", trace.sequence), slog.String("state", state))
+}
+
+func (fsm *fsm) m122TraceEvent(conn net.Conn, event string) {
+	m122Trace.Lock()
+	defer m122Trace.Unlock()
+	trace := m122Trace.connections[conn]
+	if event == "connection_open" && trace == nil {
+		m122Trace.nextID++
+		trace = &m122ConnectionTrace{logger: fsm.logger, id: m122Trace.nextID}
+		m122Trace.connections[conn] = trace
+	}
+	if trace == nil {
+		fsm.logger.Info("M122 FSM trace", slog.String("event", event),
+			slog.String("tcp_local", conn.LocalAddr().String()), slog.String("tcp_remote", conn.RemoteAddr().String()),
+			slog.Int("process_id", os.Getpid()), slog.Uint64("connection_id", 0),
+			slog.Uint64("sequence", 0), slog.String("state", "unknown"))
+		return
+	}
+	if event == "keepalive_received" {
+		trace.established = true
+	}
+	m122Emit(conn, trace, event)
+}
+
+func m122Close(conn net.Conn) error {
+	err := conn.Close()
+	m122Trace.Lock()
+	defer m122Trace.Unlock()
+	if trace := m122Trace.connections[conn]; trace != nil {
+		m122Emit(conn, trace, "connection_closed")
+		delete(m122Trace.connections, conn)
+	}
+	return err
+}
