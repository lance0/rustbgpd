@@ -0,0 +1,97 @@
+package server
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"log/slog"
+	"net"
+	"os"
+	"testing"
+
+	"github.com/osrg/gobgp/v4/pkg/packet/bgp"
+)
+
+type m122TestConn struct {
+	net.Conn
+	local, remote *net.TCPAddr
+	closed        bool
+	closeError    error
+}
+
+func (c *m122TestConn) LocalAddr() net.Addr  { return c.local }
+func (c *m122TestConn) RemoteAddr() net.Addr { return c.remote }
+func (c *m122TestConn) Close() error         { c.closed = true; return c.closeError }
+
+func TestM122ConnectionTrace(t *testing.T) {
+	var output bytes.Buffer
+	owner := &fsm{logger: slog.New(slog.NewJSONHandler(&output, nil))}
+	owner.state.Store(bgp.BGP_FSM_ESTABLISHED)
+	conn := func(port int) *m122TestConn {
+		return &m122TestConn{local: &net.TCPAddr{IP: net.ParseIP("10.0.122.2"), Port: port}, remote: &net.TCPAddr{IP: net.ParseIP("10.0.122.1"), Port: 179}}
+	}
+	incoming, outgoing := conn(41000), conn(41001)
+	owner.m122TraceEvent(incoming, "connection_open")
+	owner.m122TraceEvent(outgoing, "connection_open")
+	owner.m122TraceEvent(incoming, "keepalive_received")
+	owner.m122TraceEvent(outgoing, "collision_close")
+	sentinel := errors.New("close witness")
+	outgoing.closeError = sentinel
+	if err := m122Close(outgoing); err != sentinel || !outgoing.closed {
+		t.Fatal("close result changed")
+	}
+	m122Trace.Lock()
+	_, retained := m122Trace.connections[outgoing]
+	m122Trace.Unlock()
+	if retained {
+		t.Fatal("closed connection retained trace state")
+	}
+	// A new connection can reuse the tuple, never the prior instance's state or ID.
+	replacement := conn(41001)
+	owner.m122TraceEvent(replacement, "connection_open")
+	owner.m122TraceEvent(replacement, "collision_close")
+	owner.m122TraceEvent(incoming, "collision_close")
+	_ = m122Close(incoming)
+	_ = m122Close(replacement)
+	owner.m122TraceEvent(outgoing, "collision_close") // closed/unknown must fail closed
+	var rows []map[string]any
+	decoder := json.NewDecoder(&output)
+	for decoder.More() {
+		var row map[string]any
+		if err := decoder.Decode(&row); err != nil {
+			t.Fatal(err)
+		}
+		rows = append(rows, row)
+	}
+	if len(rows) != 11 {
+		t.Fatalf("got %d events", len(rows))
+	}
+	wantEvents := []string{"connection_open", "connection_open", "keepalive_received", "collision_close", "connection_closed", "connection_open", "collision_close", "collision_close", "connection_closed", "connection_closed", "collision_close"}
+	wantStates := []string{"pre_established", "pre_established", "established", "pre_established", "pre_established", "pre_established", "pre_established", "established", "established", "pre_established", "unknown"}
+	sequences := map[float64]float64{}
+	for i, row := range rows {
+		if row["msg"] != "M122 FSM trace" || row["event"] != wantEvents[i] || row["process_id"] != float64(os.Getpid()) || row["tcp_remote"] != "10.0.122.1:179" {
+			t.Fatalf("event %d has invalid identity: %v", i, row)
+		}
+		if row["state"] != wantStates[i] {
+			t.Fatalf("event %d state=%v", i, row["state"])
+		}
+		id, sequence := row["connection_id"].(float64), row["sequence"].(float64)
+		if id == 0 {
+			if sequence != 0 || row["state"] != "unknown" {
+				t.Fatal("unknown trace appears safe")
+			}
+			continue
+		}
+		if sequence != sequences[id]+1 {
+			t.Fatalf("event %d sequence=%v", i, sequence)
+		}
+		sequences[id] = sequence
+	}
+	if rows[1]["connection_id"] == rows[5]["connection_id"] {
+		t.Fatal("tuple reuse reused connection ID")
+	}
+	if rows[3]["tcp_local"] != "10.0.122.2:41001" || rows[7]["tcp_local"] != "10.0.122.2:41000" {
+		t.Fatal("trace names owning actor instead of target connection")
+	}
+}
