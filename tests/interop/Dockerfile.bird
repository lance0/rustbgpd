FROM debian:bookworm-slim

# tshark: M83 captures + dissects the RS↔BIRD link inside this
# container (the byte-level RFC 7947 transparency / OTC / EoR
# assertions).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive \
    apt-get install -y --no-install-recommends \
    bird2 \
    iproute2 \
    tshark \
    && rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]
