# Runtime tools only; the wrapper mounts its separately built, hashed binaries.
# Set BASE to an image compatible with the binaries' glibc when needed.
ARG BASE=ubuntu:24.04@sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254
FROM ${BASE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 iproute2 ca-certificates && rm -rf /var/lib/apt/lists/*
